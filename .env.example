# 复制成 .env 后填入真实值。
#
# `.env` 已在 .gitignore 里（用通配规则 `.env.*`，不是逐条列举）。
# 🔴 本文件是**唯一**的配置真源说明：代码里不留任何真实默认值，
#    缺哪一项由 `run_e2e.py --doctor` / `config.validate()` 显式报出来。

# ── 收信：CF Temp Email Worker（必填）────────────────────────────────
# 管理密钥：建邮箱 / 走 /admin/* 端点用
TEMPMAIL_ADMIN_KEY=
# Worker 的根地址，形如 https://<你的-worker-子域>.workers.dev
TEMPMAIL_BASE=
# 建临时邮箱用哪个域名（必须是 Worker /health 里 domains 之一）
TEMPMAIL_DOMAIN=

# ── Cloudflare API（选填：只有 tools/probes/* 诊断脚本用得到）────────
# 主流程（run_e2e / verify_keys）完全不需要这三项。
# 权限最小化：只需要 Workers Scripts:Read + D1:Read + Zone:Read。
CF_API_TOKEN=
# 32 位十六进制账号 id（Cloudflare 控制台右下角 / 任意 API 响应里能看到）
CF_ACCOUNT_ID=
# D1 数据库 id（wrangler.toml 里的 database_id）
CF_D1_ID=
# probe_email_routing.py 要逐个查 Email Routing 的域名，逗号分隔。
# 留空则改为问 Worker 的 /health，用它的 domains 列表。
TEMPMAIL_DOMAINS=

# ── 收信：MoeMail（选填：只有 --mail-backend moemail 才需要）──────────
# 自建的临时邮箱服务。建邮箱免费，但可用性取决于自己那台机器。
#
# 🔴 认证头是 `X-API-Key`，**不是** Authorization: Bearer。
#    填错的表现是全局 401，很容易被误诊成「key 失效」。
# 服务根地址，形如 https://your-moemail.example.com（不要带尾斜杠）
MOEMAIL_BASE=
MOEMAIL_API_KEY=
# 建邮箱用哪个域名。留空则自动取 `GET /api/config` 返回的第一个可用域名 ——
# ⚠️ 不要凭印象填：服务端对无效域名只回「HTTP 400 域名无效」，不告诉你有哪些是有效的。
MOEMAIL_DOMAIN=
# 邮箱有效期（毫秒）。服务端只接受这几个枚举值，填别的会被直接拒：
#   3600000（1小时）/ 86400000（1天，默认）/ 604800000（7天）/ 0（永久）
# 默认 1 天：注册分钟级就结束，但要给 resume_pending.py 补跑留余量 ——
# 邮箱一过期就收不到信了，而那时台账里只会显示「等不到邮件」。
MOEMAIL_EXPIRY_MS=86400000
