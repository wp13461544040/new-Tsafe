# 凭据 —— 用通配，不要逐条列举（`.env.bak-xxx` 这类备份一定漏）
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
venv/
env/
ENV/

# Node.js / 前端
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
.cache/
.vite/
.next/
out/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 数据库
*.db
*.sqlite
*.sqlite3

# 运行产物：台账 / 导出 / 探针输出
#
# 🔴 `*.json` 这条通配曾经把 `frontend/package.json` 与 `package-lock.json`
#    一起挡掉了 —— 两个文件**从未进仓库**，于是 CI 里 `npm ci` 直接失败
#    （2026-09-22 实测：镜像构建报 exit code 1，排查了半天才发现不是 npm 的问题，
#    是文件压根不存在）。运行产物都在固定目录下，按目录排除就够，
#    不要用全局扩展名通配去挡它们。
*.jsonl
*.csv
*.log
exports/
result/
# 探针/调试脚本的散落输出（根目录下的 json，不影响子目录里的配置文件）
/*.json
# 跑批中途传参用的批次时间戳（无源码引用，跑完就没意义）
.run_ts

# 🔴 成功数据（交付物）：含明文 API Key。
# 必须显式列目录 —— `*.txt` 没有任何通配规则覆盖，
# 光靠上面的 *.json / *.jsonl 挡不住 result/keys.txt。
result/

# 备份 / 回滚点（回填、清污、改配置时都会留一份）
*.bak
*.bak-*
*.orig
*.rej

# HAR / EML：含会话与令牌（通配已覆盖，这里显式列目录是为了可读）
*.har
*.eml
evidence/

# 工作目录整体排除（过程记录会持续累积，下次顺手回填就漏了）
.workbuddy-ai/

# 上传文件
backend/uploads/
frontend/dist/

# 图片
*.png

# 🔴 JWT 签名密钥（自动生成并落盘，跨重启稳定）。
# 提交进仓库等于任何人都能伪造 token —— 必须排除。
# 显式列目录：上面的 `*.key` 类通配没有覆盖以点开头的文件名。
backend/data/.secret_key
backend/data/
